# ============================================================================
# Variaveis de ambiente do Financeiro
#
# Copie este arquivo para `.env` e preencha. O arquivo `.env` NUNCA e versionado.
# Nenhum valor aqui e real. Em producao, prefira um gerenciador de segredos ou
# as variaveis da plataforma de hospedagem.
# ============================================================================

# --- Ambiente ---------------------------------------------------------------
# desenvolvimento | homologacao | producao
# Em "producao": cookies seguros e cadastro publico fechado depois do primeiro usuario
# (a entrada de outras pessoas e por convite).
AMBIENTE=desenvolvimento

# --- Banco de dados (PostgreSQL) --------------------------------------------
# Senhas dos tres usuarios de menor privilegio. O script de inicializacao do
# banco (scripts/banco/10-criar-usuarios.sh) le DAQUI e se recusa a rodar com
# valor vazio ou de exemplo. Gere cada uma com: openssl rand -base64 24
# As MESMAS senhas entram nas URLs abaixo.
BANCO_SENHA_APLICACAO=
BANCO_SENHA_MIGRACAO=
BANCO_SENHA_BACKUP=

# Usuario da APLICACAO: pode ler/escrever dados, mas NAO pode alterar estrutura
# nem apagar/alterar auditoria. Ver docs/arquitetura/banco-dados.md.
BANCO_URL=postgres://financeiro_aplicacao:SENHA_DA_APLICACAO@localhost:5432/financeiro

# Usuario de MIGRACAO: usado apenas por `pnpm banco:migrar`. Pode alterar estrutura.
BANCO_URL_MIGRACAO=postgres://financeiro_migracao:SENHA_DA_MIGRACAO@localhost:5432/financeiro

# Banco usado pelos TESTES de integracao (src/banco-dados/testes/). Sem esta
# variavel as suites que exigem PostgreSQL sao puladas, e `pnpm testar` passa
# sem ter provado restricoes, privilegios, transacoes nem isolamento.
# Use o usuario da APLICACAO, para provar os limites reais.
#
# BANCO SEPARADO, NUNCA O DE DESENVOLVIMENTO. Os testes criam e apagam dados,
# inclusive empresas inteiras: apontar para o banco de trabalho significa ver
# o proprio cadastro sumir no meio de uma conferencia, e confundir sobra de
# teste com dado real. Crie o banco com `pnpm banco:preparar-teste`.
BANCO_URL_TESTE=postgres://financeiro_aplicacao:SENHA_DA_APLICACAO@localhost:5432/financeiro_teste

# Tamanho maximo do pool de conexoes da aplicacao (padrao 10).
BANCO_MAXIMO_CONEXOES=10

# --- Aplicacao --------------------------------------------------------------
# URL publica completa (usada em links de e-mail, cookies e OAuth).
APLICACAO_URL=http://localhost:3000

# Segredo para assinar sessoes e tokens. Minimo 32 caracteres aleatorios.
# Gere com: openssl rand -base64 48
APLICACAO_SEGREDO=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# --- "Continuar com Google" (opcional) --------------------------------------
# Crie credenciais OAuth no Google Cloud. Deixe vazio para desativar o botao.
GOOGLE_CLIENTE_ID=
GOOGLE_CLIENTE_SEGREDO=

# --- E-mail -----------------------------------------------------------------
# console (escreve no log; so em desenvolvimento) | smtp
EMAIL_PROVEDOR=console
EMAIL_REMETENTE="Financeiro <nao-responda@suaempresa.com.br>"
# Ex.: smtps://usuario:senha@smtp.provedor.com.br:465
SMTP_URL=

# --- Inteligencia artificial (opcional, contratada separadamente) -----------
# desligado | anthropic | openai | local
# Com "desligado", os pontos de atencao deterministicos continuam funcionando.
IA_PROVEDOR=desligado
IA_CHAVE_API=
IA_MODELO=
# Para modelo local ou proxy compativel (ex.: http://ia-local:11434)
IA_URL_BASE=

# --- Licenciamento ----------------------------------------------------------
# Caminho do arquivo de licenca entregue ao cliente. Sem arquivo, a instalacao
# roda no modo base da versao 1.x (ver docs/licenciamento.md).
LICENCA_ARQUIVO=./licenca.json

# --- Tarefas em segundo plano ----------------------------------------------
# Intervalo (ms) entre verificacoes da fila quando nao ha tarefas.
TAREFAS_INTERVALO_MS=2000

# --- Observabilidade --------------------------------------------------------
# debug | info | aviso | erro
LOG_NIVEL=info

# Sal do HMAC que anonimiza o IP na auditoria e no limite de tentativas da
# captura por QR code. Obrigatorio em producao e demonstracao; opcional aqui.
# Gere com: openssl rand -base64 48
# NUNCA vai para o banco. Guarde a copia no mesmo cofre da chave GPG do backup:
# sem o mesmo sal, uma restauracao continua funcionando, mas os IPs novos deixam
# de ser comparaveis com os antigos (o prefixo "v1:" no hash torna isso visivel).
AUDITORIA_SAL_IP=

# Raiz do armazenamento de arquivos em disco (documentos capturados por QR code).
# Em producao e o volume `arquivos` do compose, montado em /aplicacao/arquivos.
ARQUIVOS_DIRETORIO=./arquivos
