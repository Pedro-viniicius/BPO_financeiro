# ============================================================================
# Variaveis de PRODUCAO (Modelo A — VPS do fornecedor).
#
# Copie para `.env` NO SERVIDOR e preencha. Este arquivo e so o molde: ele e
# versionado e NUNCA pode conter valor real. O `.env` de verdade fica apenas
# no servidor, com permissao 600 e dono do usuario que roda o compose.
#
#   cp .env.producao.exemplo .env
#   chmod 600 .env
#
# Gerar segredos:
#   openssl rand -base64 48      (APLICACAO_SEGREDO)
#   openssl rand -base64 24      (cada senha de banco)
# ============================================================================

AMBIENTE=producao

# --- Dominio e certificado --------------------------------------------------
# O DNS deste dominio precisa apontar para o IP do VPS ANTES de subir: o Caddy
# so consegue o certificado se o Let's Encrypt alcancar o servidor pela porta 80.
DOMINIO=financeiro.novadidata.com.br
# Para onde o Let's Encrypt avisa que um certificado vai expirar sem renovar.
EMAIL_CERTIFICADO=ti@seudominio.com.br

APLICACAO_URL=https://financeiro.novadidata.com.br
# 48 bytes em base64. Trocar este valor DESLOGA todo mundo: nao e rotina.
APLICACAO_SEGREDO=

# --- Banco ------------------------------------------------------------------
# Tres senhas DIFERENTES. O compose usa BANCO_SENHA_ADMIN e BANCO_SENHA_BACKUP;
# as URLs carregam as senhas da aplicacao e da migracao.
#
# ATENCAO: as senhas tambem precisam entrar em scripts/banco/criar-usuarios.sql
# ANTES do primeiro `up`, porque ele so roda na criacao do volume do banco.
BANCO_SENHA_ADMIN=
BANCO_SENHA_BACKUP=
BANCO_URL=postgres://financeiro_aplicacao:SENHA_DA_APLICACAO@banco:5432/financeiro
BANCO_URL_MIGRACAO=postgres://financeiro_migracao:SENHA_DA_MIGRACAO@banco:5432/financeiro
BANCO_MAXIMO_CONEXOES=10

# Em producao, NAO defina BANCO_URL_TESTE. Os testes escrevem e apagam dados.

# --- Backup -----------------------------------------------------------------
BACKUP_RETENCAO_DIAS=30

# Copia FORA do servidor. Backup que so existe no proprio VPS protege contra
# "apaguei sem querer", nao contra o VPS sumir — que e o caso que fecha a
# empresa. Destino no formato do rclone: "<remoto>:<balde>/<pasta>".
# As credenciais ficam em ./segredos/rclone.conf, no servidor, fora do git.
BACKUP_REMOTO_DESTINO=
BACKUP_REMOTO_RETENCAO_DIAS=90

# Destinatario GPG. Recomendado sempre que o backup sai do servidor: o arquivo
# tem todos os dados financeiros do cliente em claro.
BACKUP_CHAVE_PUBLICA_GPG=

# --- E-mail -----------------------------------------------------------------
# Enquanto SMTP_URL estiver vazia, convites saem como LINK para copiar, e a
# tela avisa. Ver a pendencia de SMTP no relatorio do Gate 4.
EMAIL_PROVEDOR=smtp
EMAIL_REMETENTE="Financeiro Nova Didata <financeiro@novadidata.com.br>"
SMTP_URL=

# --- Opcionais --------------------------------------------------------------
GOOGLE_CLIENTE_ID=
GOOGLE_CLIENTE_SEGREDO=
IA_PROVEDOR=desligado
IA_CHAVE_API=
IA_MODELO=
IA_URL_BASE=
LICENCA_ARQUIVO=licenca.json
TAREFAS_INTERVALO_MS=60000
LOG_NIVEL=info

# Sal do HMAC que anonimiza o IP na auditoria e no limite de tentativas da
# captura por QR code. OBRIGATORIO: sem ele a aplicacao nao sobe.
# Gere com: openssl rand -base64 48
# NUNCA vai para o banco. Guarde a copia no mesmo cofre da chave GPG do backup.
AUDITORIA_SAL_IP=

# Raiz do armazenamento de arquivos: o volume `arquivos` do compose.
# Entra no backup (scripts/backup.sh) — arquivo sem backup e nota fiscal perdida.
ARQUIVOS_DIRETORIO=/aplicacao/arquivos

# (Opcional) Janela, em dias, em que o backup procura chaves expurgadas para
# apagar da copia remota. Padrao 7: o backup roda todo dia, entao 7 da folga
# para uma semana de backups perdidos sem deixar arquivo expurgado no remoto.
BACKUP_JANELA_EXPURGO_DIAS=7
