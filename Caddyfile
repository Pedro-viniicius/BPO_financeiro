# ============================================================================
# Proxy reverso com HTTPS automatico.
#
# O Caddy obtem e renova o certificado sozinho (Let's Encrypt), desde que o
# DNS do dominio aponte para este servidor e as portas 80 e 443 estejam
# abertas. Sem HTTPS o sistema nao funciona de verdade: os cookies de sessao
# sao `Secure`, e o navegador simplesmente nao os envia em http.
# ============================================================================
{
	email {$EMAIL_CERTIFICADO}
	# Sem servidor de administracao: nada a expor.
	admin off
}

{$DOMINIO} {
	encode zstd gzip

	# Envio de documentos pela pagina publica (Gate 10): o corpo e cortado AQUI,
	# antes de chegar a aplicacao, com 413. So nesta rota — o resto do site nao
	# recebe arquivo por formulario nativo. 41 MB = 40 MB de envio + folga do
	# multipart; a aplicacao confere de novo pelo Content-Length.
	@recebimento path_regexp ^/enviar/[A-Za-z0-9_-]{22}/receber$
	request_body @recebimento {
		max_size 41MB
	}

	# A aplicacao so e alcancavel por aqui — ela nao publica porta no host.
	reverse_proxy aplicacao:3000

	header {
		# HSTS: depois da primeira visita, o navegador se recusa a usar http.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# O proprio next.config.ts ja manda X-Frame-Options: DENY.
		-Server
	}

	log {
		output file /data/acesso.log {
			roll_size 10MiB
			roll_keep 5
			# Marco Civil, art. 15: registros de acesso guardados por 6 meses.
			# Passado isso, sao descartados — nao rotacionados para sempre.
			roll_keep_for 4380h
		}
		# A URL de /enviar carrega o token da empresa: fica no log com o token
		# apagado, mantendo IP, porta de origem e horario. Nao se pula a rota:
		# o acesso a ela e justamente o que se quer poder auditar.
		format filter {
			fields {
				request>uri regexp "/enviar/[A-Za-z0-9_-]{22}" "/enviar/<token>"
			}
			wrap json
		}
	}
}
