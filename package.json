{
  "name": "financeiro",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "Plataforma de gestao financeira para BPO financeiro, tesouraria e controle gerencial de pequenas e medias empresas brasileiras.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "iniciar": "next start",
    "lint": "eslint .",
    "verificar:tipos": "tsc --noEmit",
    "verificar:arquitetura": "depcruise src --config .dependency-cruiser.cjs",
    "verificar:arquitetura:grafico": "depcruise src --config .dependency-cruiser.cjs --output-type dot > docs/arquitetura/grafo-dependencias.dot",
    "verificar:licencas": "node scripts/verificar-licencas.mjs",
    "testar": "vitest run",
    "testar:observar": "vitest",
    "verificar:tudo": "pnpm lint && pnpm verificar:tipos && pnpm verificar:arquitetura && pnpm testar && pnpm verificar:licencas && pnpm build",
    "banco:gerar": "drizzle-kit generate",
    "banco:migrar": "tsx src/banco-dados/migrar.ts",
    "banco:estudio": "drizzle-kit studio",
    "tarefas:executar": "tsx src/nucleo/tarefas/executor-linha-comando.ts"
  },
  "dependencies": {
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.2",
    "next": "16.3.5",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "18.3.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "26.1.0",
    "license-checker-rseidelsohn": "5.0.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
